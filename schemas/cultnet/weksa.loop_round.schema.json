{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoundRecord",
  "description": "One scored round. It holds no text and no Test reading: per-item rows for\nTrain only, Validation only as means and refusal counts by stage. Only\n`run::round` builds one.\n\n```\nfn f(r: &weksa::run::RoundRecord) -> u32 { r.n() }\n```\n\n```compile_fail\nfn f() -> weksa::run::RoundRecord {\n    weksa::run::RoundRecord { n: 1 }\n}\n```",
  "type": "object",
  "properties": {
    "calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Call"
      }
    },
    "chrf_version": {
      "type": "string"
    },
    "corpus_digest": {
      "type": "string"
    },
    "embedder": {
      "type": "string"
    },
    "entity_digest": {
      "type": "string"
    },
    "inventory_rev": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "lowerer_digest": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "n": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "prompt_digest": {
      "type": "string"
    },
    "train": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrainRow"
      }
    },
    "train_mean": {
      "$ref": "#/$defs/SplitMean"
    },
    "validation_mean": {
      "$ref": "#/$defs/SplitMean"
    },
    "validation_refused": {
      "$ref": "#/$defs/RefusalCounts"
    }
  },
  "required": [
    "n",
    "inventory_rev",
    "prompt_digest",
    "lowerer_digest",
    "corpus_digest",
    "entity_digest",
    "model",
    "embedder",
    "chrf_version",
    "calls",
    "train",
    "train_mean",
    "validation_mean",
    "validation_refused"
  ],
  "$defs": {
    "Call": {
      "description": "One model call: the prompt's digest and the item keys it held.",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "items"
      ]
    },
    "Outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Scored": {
              "type": "object",
              "properties": {
                "chrf": {
                  "type": "number",
                  "format": "double"
                },
                "meaning": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                }
              },
              "required": [
                "chrf"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Scored"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Refused": {
              "$ref": "#/$defs/Stage"
            }
          },
          "additionalProperties": false,
          "required": [
            "Refused"
          ]
        }
      ]
    },
    "RefusalCounts": {
      "type": "object",
      "properties": {
        "admit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lower": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "parse": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "parse",
        "admit",
        "lower"
      ]
    },
    "SplitMean": {
      "description": "Mean scores of one derived split.",
      "type": "object",
      "properties": {
        "chrf": {
          "description": "`None` when the split has no items.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "meaning": {
          "description": "Mean over the items that have a meaning score; `None` when none do.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "count"
      ]
    },
    "Stage": {
      "description": "Where a round refused: the first stage that did.",
      "type": "string",
      "enum": [
        "Parse",
        "Admit",
        "Lower"
      ]
    },
    "TrainRow": {
      "description": "A Train item's row. Validation has no rows.",
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "packet": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "item",
        "outcome"
      ]
    }
  }
}
