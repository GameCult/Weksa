{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InventoryRevision",
  "description": "Key: `rev:<n>`.",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Change"
      }
    },
    "frozen": {
      "type": "boolean"
    },
    "n": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "parent": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "n",
    "changes",
    "frozen"
  ],
  "$defs": {
    "Change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Add": {
              "$ref": "#/$defs/InvId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Retire": {
              "$ref": "#/$defs/InvId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Retire"
          ]
        }
      ]
    },
    "InvId": {
      "type": "string",
      "pattern": "^(concept|frame|role|relation|speech_act|feature|referent_kind|extension):[1-9][0-9]*$"
    }
  }
}
